# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: free key at https://app.tavily.com. Without it, web_search serves the offline cache.
TAVILY_API_KEY=tvly-...

# Optional overrides (OpenRouter model slugs)
# ORCHESTRATOR_MODEL=anthropic/claude-sonnet-5
# SPECIALIST_MODEL=anthropic/claude-haiku-4.5
# EMBED_MODEL=mistralai/mistral-embed-2312
